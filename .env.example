# Copy to `.env` (gitignored) beside docker-compose.yml and change what differs. Every line shows its default.

# The release to pull (the image's tag, e.g. 0.1.0); empty or unset: the latest. For a build from source
# (docker-compose.build.yml) it is the version the server reports: set it to `sh scripts/version.sh`.
# DRAWER_VERSION=

# Where the port is published on the host. There is no sign-in, so the default is loopback: only this machine reaches it.
# To use drawer from other devices, set the address of a PRIVATE interface (a VPN or tailnet address, e.g. 100.x.y.z),
# or keep loopback and put a reverse proxy on a private network in front. Never 0.0.0.0 on a machine that a network you
# do not control can reach. Read SECURITY.md first.
DRAWER_BIND=127.0.0.1
DRAWER_PORT=3050

# Host names the server answers to, comma-separated, without scheme or port (e.g. drawer.lan,host.tailnet.ts.net).
# An IP address and `localhost` always work; any other name must be listed here, or the server refuses the request.
# This is what stops a web page from reaching drawer through a DNS name it controls (DNS rebinding).
DRAWER_ALLOWED_HOSTS=

# The server's time zone, for dates in notes and history.
TZ=UTC

# The most memory the container may use. A model is untrusted text; this stops a runaway render from taking the host down.
DRAWER_MEMORY=4g

# The user the server runs as: the owner of ./data on the host. Change both when `id -u` is not 1000, or the server
# cannot write there and does not start.
DRAWER_UID=1000
DRAWER_GID=1000

# Import credentials, all optional: without one, that site's models are imported with their page details only.
# Printables needs none.
THINGIVERSE_TOKEN=
MAKERWORLD_TOKEN=
CULTS3D_USER=
CULTS3D_KEY=
MYMINIFACTORY_KEY=
